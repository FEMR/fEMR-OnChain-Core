# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ENVIRONMENT=LOCAL
DJANGO_SETTINGS_MODULE=femr_onchain.settings
SILK_OFF=1

# Admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com

# PostgreSQL (use this OR RDS, not both)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASS=postgres
POSTGRES_NAME=database

# RDS (AWS managed Postgres — alternative to POSTGRES_* above)
# RDS_HOSTNAME=
# RDS_DB_NAME=
# RDS_USERNAME=
# RDS_PASSWORD=
# RDS_PORT=5432

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=user@example.com
EMAIL_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=server@example.com

# Dev email override (development only)
# DEV_EMAIL=dev@example.com

# Celery
CELERY_BROKER=redis://cache:6379/0
CELERY_BACKEND=redis://cache:6379/0

# Caching (optional — uses local memory cache if not set)
# MEMCACHED_ENDPOINT=

# QLDB (AWS Quantum Ledger Database)
QLDB_ENABLED=FALSE
qldb_name=fEMR-OnChain-Test

# AWS (required if QLDB_ENABLED=TRUE or using S3)
# aws_access_key_id=
# aws_secret_access_key=
# aws_storage_bucket_name=
